// vim:ft=javascript

ARG_ENABLE('true-async-server', 'Enable TrueAsync HTTP Server extension', 'no');
ARG_ENABLE('http2', 'Enable HTTP/2 in true_async_server (requires nghttp2)', 'yes');
ARG_ENABLE('http3', 'Enable HTTP/3 in true_async_server (requires ngtcp2, nghttp3, OpenSSL >= 3.5)', 'no');
ARG_ENABLE('http-compression', 'Enable HTTP body compression (gzip via zlib)', 'yes');
ARG_ENABLE('brotli',            'Enable Brotli backend (requires libbrotli)', 'yes');
ARG_ENABLE('zstd',              'Enable zstd backend (requires libzstd)',     'yes');
ARG_ENABLE('websocket',         'Enable WebSocket (RFC 6455) via bundled wslay', 'yes');

if (PHP_TRUE_ASYNC_SERVER == "yes") {

    // Hard ZTS requirement: worker/reactor pools run PHP threads and the
    // core uses TSRM mutexes — fail configure, not compilation.
    if (PHP_ZTS != "yes") {
        ERROR("true_async_server requires a ZTS PHP build; NTS is not supported");
    }

    // Subdir paths MUST use backslashes — confutils.js ADD_SOURCES() splits
    // on '\\' to derive (dirname, filename); forward slashes leave dirname
    // empty and the .obj lands in build-dir root while the linker looks for
    // it under build-dir\src\, producing LNK1181.
    var http_server_sources =
        "src\\http_server.c " +
        "src\\http_server_config.c " +
        "src\\http_server_class.c " +
        "src\\http_request.c " +
        "src\\http_response.c " +
        "src\\http_response_framing.c " +
        "src\\grpc\\grpc.c " +
        "src\\grpc\\grpc_call.c " +
        "src\\http_sse.c " +
        "src\\http_response_server_api.c " +
        "src\\uploaded_file.c " +
        // HTTP utilities (mirrors config.m4 base source list)
        "src\\http_mime.c " +
        "src\\http_date.c " +
        "src\\http_etag.c " +
        "src\\http_range.c " +
        "src\\http_rfc5987.c " +
        "src\\http_precompressed.c " +
        "src\\http_param_parse.c " +
        "src\\send_file.c " +
        "src\\http_send_file.c " +
        "src\\http_send_file_options.c " +
        "src\\http_body_stream.c ";

    var http_server_core =
        "conn_arena.c " +
        "body_pool.c " +
        "async_plain_event.c " +
        "thread_queue.cc " +
        "thread_mailbox.c " +
        "reactor_pool.c " +
        "reactor_pool_test_hooks.c " +
        "response_wire.c " +
        "worker_dispatch.c " +
        "worker_inbox.c " +
        "worker_registry.c " +
        "stats_registry.c " +
        "http_connection.c " +
        "http_connection_tls.c " +
        "http_protocol_handlers.c " +
        "http_protocol_strategy.c " +
        "tls_layer.c " +
        "http_known_strings.c ";

    var http_server_http1 =
        "http_parser.c " +
        "http1_stream.c " +
        "http1_sendfile.c " +
        "http1_format.c ";

    var http_server_http3 =
        "http3_listener.c " +
        "http3_packet.c " +
        "http3_connection.c " +
        "http3_io.c " +
        "http3_callbacks.c " +
        "http3_dispatch.c " +
        "http3_stream.c " +
        "http3_stream_pool.c " +
        "http3_static_response.c " +
        "http3_steer.c ";

    var http_server_formats =
        "multipart_parser.c " +
        "multipart_processor.c ";

    var http_server_log =
        "http_log.c " +
        "trace_context.c ";

    // Rooms are the pub/sub core and carry no WebSocket of their own, so they
    // build wherever the extension does — HttpServer::publish(), ::send() and
    // ::enableRooms() are declared unconditionally and the link needs them.
    var http_server_room =
        "room_hub.c " +
        "room_tree.c " +
        "php_room.c ";

    var http_server_static =
        "static_handler_class.c " +
        "http_static_path.c " +
        "http_static_cache.c " +
        "http_static.c " +
        "http_static_safety.c ";

    // llhttp bundled
    var http_server_llhttp =
        "llhttp.c " +
        "api.c " +
        "http.c ";

    EXTENSION("true_async_server", http_server_sources);
    ADD_SOURCES(configure_module_dirname + "/src/core",    http_server_core,    "true_async_server");
    ADD_SOURCES(configure_module_dirname + "/src/http1",   http_server_http1,   "true_async_server");
    ADD_SOURCES(configure_module_dirname + "/src/formats", http_server_formats, "true_async_server");
    ADD_SOURCES(configure_module_dirname + "/src/log",     http_server_log,     "true_async_server");
    ADD_SOURCES(configure_module_dirname + "/src/room",    http_server_room,    "true_async_server");
    ADD_SOURCES(configure_module_dirname + "/src/static",  http_server_static,  "true_async_server");
    ADD_SOURCES(configure_module_dirname + "/deps/llhttp", http_server_llhttp,  "true_async_server");

    // Include paths
    // Module root holds the flat public header php_true_async_server.h,
    // reached from include/php_http_server.h.
    ADD_FLAG("CFLAGS_TRUE_ASYNC_SERVER", "/I " + configure_module_dirname);
    ADD_FLAG("CFLAGS_TRUE_ASYNC_SERVER", "/I " + configure_module_dirname + "/include");
    ADD_FLAG("CFLAGS_TRUE_ASYNC_SERVER", "/I " + configure_module_dirname + "/src");
    ADD_FLAG("CFLAGS_TRUE_ASYNC_SERVER", "/I " + configure_module_dirname + "/src/core");
    ADD_FLAG("CFLAGS_TRUE_ASYNC_SERVER", "/I " + configure_module_dirname + "/deps/llhttp/include");
    // moodycamel inter-thread queue headers (issue #81), consumed by thread_queue.cc.
    ADD_FLAG("CFLAGS_TRUE_ASYNC_SERVER", "/I " + configure_module_dirname + "/deps/concurrentqueue");
    // static/ files include each other by short name (e.g. "static/http_static_safety.h")
    ADD_FLAG("CFLAGS_TRUE_ASYNC_SERVER", "/I " + configure_module_dirname + "/include/static");

    ADD_FLAG("CFLAGS_TRUE_ASYNC_SERVER", "/D HTTP_SERVER_EXPORTS /D HAVE_LLHTTP=1");

    // Hardening + diagnostic flags (mirrors config.m4 / CMakeLists.txt
    // hardening block). /GS is on by default in modern MSVC but stating
    // it explicitly documents intent. /sdl turns warnings about unsafe
    // C runtime calls into errors. /guard:cf enables Control Flow Guard.
    // /W4 raises the default warning level from /W3.
    //
    // /wd4701 /wd4703 — silence MSVC's "potentially uninitialized" false
    // positives over PHP's Z_PARAM_*/ZEND_PARSE_PARAMETERS_* macros. The
    // analyser cannot model that ZEND_PARSE_PARAMETERS_END returns control
    // only when every Z_PARAM_* slot has been written; under /sdl C4703 is
    // promoted to an error and the entire ext fails to compile. The Z_PARAM
    // macros are correct (every slot is assigned before the END marker) so
    // this is a tooling limitation, not a real bug.
    // /wd4068 — the vendored moodycamel headers guard their own warnings with
    // #pragma GCC, which MSVC reports as an unknown pragma; under /WX that
    // stops the build. Our own code guards those pragmas on __GNUC__, so this
    // covers deps/ alone.
    ADD_FLAG("CFLAGS_TRUE_ASYNC_SERVER", "/W4 /GS /sdl /guard:cf /wd4068 /wd4701 /wd4703 /std:c11");

    // /EHsc enables C++ exception unwinding for the one C++ TU (thread_queue.cc,
    // issue #81); moodycamel and operator new can throw and the wrapper catches.
    ADD_FLAG("CFLAGS_TRUE_ASYNC_SERVER", "/EHsc");

    // OpenSSL (required for TLS layer inside the extension — matches config.m4
    // default of --with-openssl=yes).
    if (CHECK_HEADER_ADD_INCLUDE("openssl/ssl.h", "CFLAGS_TRUE_ASYNC_SERVER", PHP_PHP_BUILD + "\\include")
        && CHECK_LIB("libssl.lib", "true_async_server")
        && CHECK_LIB("libcrypto.lib", "true_async_server")) {
        AC_DEFINE("HAVE_OPENSSL", 1, "Whether OpenSSL TLS support is available");
    } else {
        WARNING("OpenSSL not found at '" + PHP_PHP_BUILD + "' — TLS layer will fail to compile. " +
                "Drop libssl.lib/libcrypto.lib into '" + PHP_PHP_BUILD + "\\lib' and headers into '\\include\\openssl'.");
    }

    // WebSocket (RFC 6455) — bundled wslay frame parser plus our strategy,
    // session bridge, handshake, dispatch and PHP object layer. Mirrors the
    // --enable-websocket block of config.m4.
    //
    // It sits below the include-path section because ADD_FLAG skips a flag
    // that is a substring of one already added: the wslay include path added
    // first would swallow the module root's own /I, and every file reached
    // through php_true_async_server.h would stop resolving.
    if (PHP_WEBSOCKET == "yes") {
        AC_DEFINE("HAVE_WSLAY", 1, "Whether bundled wslay is available");
        AC_DEFINE("HAVE_HTTP_SERVER_WEBSOCKET", 1, "Whether WebSocket support is enabled");

        // The pure-C wslay translation units include no PHP header, so a macro
        // reaching them through main/config.w32.h never arrives: pass the two
        // this extension owns on the command line, as the compression block
        // does. htons()/ntohs() come from winsock2.h, which wslay includes
        // only under HAVE_WINSOCK2_H.
        ADD_FLAG("CFLAGS_TRUE_ASYNC_SERVER", "/D HAVE_WSLAY=1");
        ADD_FLAG("CFLAGS_TRUE_ASYNC_SERVER", "/D HAVE_HTTP_SERVER_WEBSOCKET=1");
        ADD_FLAG("CFLAGS_TRUE_ASYNC_SERVER", "/D HAVE_WINSOCK2_H=1");
        // wslay.h types its callbacks with ssize_t, which MSVC does not have.
        // php-src answers this with `#define ssize_t SSIZE_T` in config.w32.h,
        // a header these translation units never see; SSIZE_T itself comes from
        // BaseTsd.h, force-included because wslay.h includes no Windows header.
        ADD_FLAG("CFLAGS_TRUE_ASYNC_SERVER", "/FI BaseTsd.h");
        ADD_FLAG("CFLAGS_TRUE_ASYNC_SERVER", "/D ssize_t=SSIZE_T");
        ADD_FLAG("CFLAGS_TRUE_ASYNC_SERVER", "/I " + configure_module_dirname + "/deps/wslay/includes");

        ADD_SOURCES(configure_module_dirname + "/deps/wslay/lib",
            "wslay_event.c wslay_frame.c wslay_net.c wslay_queue.c wslay_stack.c",
            "true_async_server");
        ADD_SOURCES(configure_module_dirname + "/src/websocket",
            "websocket_strategy.c ws_session.c ws_handshake.c ws_dispatch.c php_websocket.c",
            "true_async_server");
    }

    // HTTP/2 (optional)
    if (PHP_HTTP2 == "yes") {
        if (CHECK_HEADER_ADD_INCLUDE("nghttp2/nghttp2.h", "CFLAGS_TRUE_ASYNC_SERVER", PHP_PHP_BUILD + "\\include")
            && CHECK_LIB("nghttp2.lib", "true_async_server")) {
            AC_DEFINE("HAVE_HTTP2", 1, "Whether HTTP/2 support is enabled");
            ADD_FLAG("CFLAGS_TRUE_ASYNC_SERVER", "/D HAVE_HTTP2=1");
            ADD_SOURCES(configure_module_dirname + "/src/http2",
                "http2_strategy.c http2_session.c http2_stream.c http2_static_response.c",
                "true_async_server");
        } else {
            ERROR("nghttp2 not found. Install headers to '" + PHP_PHP_BUILD + "\\include\\nghttp2' and nghttp2.lib to '\\lib'.");
        }
    }

    // HTTP/3 (optional). Mirrors config.m4 §HTTP/3:
    //   ngtcp2 >= 1.6, nghttp3 >= 1.4, OpenSSL >= 3.5 (QUIC TLS API),
    //   libngtcp2_crypto_ossl glue. Fail-hard on Windows when --enable-http3
    //   is asked for: pkg-config-style fail-soft on Linux is meant to keep
    //   distro builds working when a dep is missing; on Windows the user
    //   has explicitly opted in by passing --enable-http3, so a clear
    //   error beats silently skipping the H3 sources.
    if (PHP_HTTP3 == "yes") {
        var _h3_ok = true;
        // OpenSSL version probe — opensslv.h defines OPENSSL_VERSION_STR.
        // We grep it because configure.js has no semantic version compare.
        var _ossl_ver_h = PHP_PHP_BUILD + "\\include\\openssl\\opensslv.h";
        var _ossl_ok = false;
        if (FSO.FileExists(_ossl_ver_h)) {
            var f = FSO.OpenTextFile(_ossl_ver_h, 1);
            var t = f.ReadAll(); f.Close();
            var m = t.match(/OPENSSL_VERSION_STR\s+"(\d+)\.(\d+)\.(\d+)/);
            if (m && (parseInt(m[1]) > 3 || (parseInt(m[1]) == 3 && parseInt(m[2]) >= 5))) {
                _ossl_ok = true;
            } else if (m) {
                WARNING("HTTP/3 disabled: OpenSSL " + m[1] + "." + m[2] + "." + m[3] + " < 3.5 (QUIC TLS API required).");
            }
        }
        if (!_ossl_ok) { _h3_ok = false; }

        if (_h3_ok && !(CHECK_HEADER_ADD_INCLUDE("ngtcp2/ngtcp2.h", "CFLAGS_TRUE_ASYNC_SERVER", PHP_PHP_BUILD + "\\include")
            && CHECK_HEADER_ADD_INCLUDE("ngtcp2/ngtcp2_crypto_ossl.h", "CFLAGS_TRUE_ASYNC_SERVER", PHP_PHP_BUILD + "\\include")
            && CHECK_LIB("ngtcp2.lib", "true_async_server")
            && CHECK_LIB("ngtcp2_crypto_ossl.lib", "true_async_server"))) {
            WARNING("HTTP/3 disabled: ngtcp2 + ngtcp2_crypto_ossl not found in '" + PHP_PHP_BUILD + "'.");
            _h3_ok = false;
        }
        if (_h3_ok && !(CHECK_HEADER_ADD_INCLUDE("nghttp3/nghttp3.h", "CFLAGS_TRUE_ASYNC_SERVER", PHP_PHP_BUILD + "\\include")
            && CHECK_LIB("nghttp3.lib", "true_async_server"))) {
            WARNING("HTTP/3 disabled: nghttp3 not found in '" + PHP_PHP_BUILD + "'.");
            _h3_ok = false;
        }

        if (_h3_ok) {
            AC_DEFINE("HAVE_HTTP_SERVER_HTTP3", 1, "Whether HTTP/3 support is enabled");
            ADD_FLAG("CFLAGS_TRUE_ASYNC_SERVER", "/D HAVE_HTTP_SERVER_HTTP3=1");
            AC_DEFINE("HAVE_NGTCP2", 1, "Whether ngtcp2 is available");
            AC_DEFINE("HAVE_NGHTTP3", 1, "Whether nghttp3 is available");
            ADD_SOURCES(configure_module_dirname + "/src/http3", http_server_http3, "true_async_server");
            ADD_FLAG("CFLAGS_TRUE_ASYNC_SERVER", "/I " + configure_module_dirname + "/src/http3");
            ADD_FLAG("CFLAGS_TRUE_ASYNC_SERVER", "/I " + configure_module_dirname + "/include/http3");
            // Static-link convention on Windows: nghttp3.h / ngtcp2.h gate
            // their __declspec(dllimport) on these macros — without them,
            // the linker chases imports against a non-existent .dll. The
            // PHP-SDK ships nghttp2 the same way for the H/2 build.
            ADD_FLAG("CFLAGS_TRUE_ASYNC_SERVER", "/D NGTCP2_STATICLIB /D NGHTTP3_STATICLIB");
            // ngtcp2 + ngtcp2_crypto_ossl pull in OS networking + bcrypt
            // (RAND, SHA, etc.) via the OpenSSL static glue. ws2_32 +
            // Mswsock are already in LIBS for the TCP path; bcrypt and
            // crypt32 are the pieces specific to libcrypto's CNG fallback
            // and ngtcp2's source-of-randomness probes.
            ADD_FLAG("LIBS", "bcrypt.lib crypt32.lib");
        } else {
            ERROR("HTTP/3 was requested but prerequisites are missing. Install OpenSSL >= 3.5, ngtcp2 >= 1.6, ngtcp2_crypto_ossl, nghttp3 >= 1.4 into '" + PHP_PHP_BUILD + "', or omit --enable-http3.");
        }
    }

    // HTTP body compression (issues #8, #9). Mirrors config.m4 — gzip is
    // the base, brotli + zstd plug into the same vtable. zlib ships with
    // the PHP SDK; brotli + zstd headers/libs must be supplied by the
    // user under PHP_PHP_BUILD\\include\\{brotli,zstd}.
    var http_server_compression =
        "http_compression.c " +
        "http_compression_gzip.c " +
        "http_compression_pool.c " +
        "http_compression_defaults.c " +
        "http_compression_negotiate.c " +
        "http_compression_response.c " +
        "http_compression_request.c ";

    if (PHP_HTTP_COMPRESSION == "yes") {
        if (CHECK_HEADER_ADD_INCLUDE("zlib.h", "CFLAGS_TRUE_ASYNC_SERVER", PHP_PHP_BUILD + "\\include")
            && CHECK_LIB("zlib_a.lib;zlib.lib", "true_async_server")) {
            AC_DEFINE("HAVE_HTTP_COMPRESSION", 1, "Whether HTTP body compression is enabled");
            // Every feature macro below is also passed on the command line.
            // AC_DEFINE writes it into config.w32.h, which a source file sees
            // only through php.h, and the files that read these macros are
            // partly pure C: the negotiator and the codec registry include no
            // PHP header at all, so the feature would compile out of the two
            // places that decide whether a response is compressed.
            ADD_FLAG("CFLAGS_TRUE_ASYNC_SERVER", "/D HAVE_HTTP_COMPRESSION=1");
            ADD_SOURCES(configure_module_dirname + "/src/compression",
                http_server_compression, "true_async_server");
            ADD_FLAG("CFLAGS_TRUE_ASYNC_SERVER", "/I " + configure_module_dirname + "/include/compression");
        } else {
            WARNING("HTTP body compression disabled: zlib not found in '" + PHP_PHP_BUILD + "'.");
            PHP_HTTP_COMPRESSION = "no";
        }
    }

    // Brotli — requires libbrotlienc + libbrotlidec; static-link convention
    // matches nghttp3/ngtcp2 above (the bundled brotli headers gate
    // __declspec(dllimport) on a STATIC define).
    if (PHP_BROTLI == "yes" && PHP_HTTP_COMPRESSION == "yes") {
        if (CHECK_HEADER_ADD_INCLUDE("brotli/encode.h", "CFLAGS_TRUE_ASYNC_SERVER", PHP_PHP_BUILD + "\\include")
            && CHECK_HEADER_ADD_INCLUDE("brotli/decode.h", "CFLAGS_TRUE_ASYNC_SERVER", PHP_PHP_BUILD + "\\include")
            && CHECK_LIB("brotlienc.lib;brotlienc-static.lib", "true_async_server")
            && CHECK_LIB("brotlidec.lib;brotlidec-static.lib", "true_async_server")
            && CHECK_LIB("brotlicommon.lib;brotlicommon-static.lib", "true_async_server")) {
            AC_DEFINE("HAVE_HTTP_BROTLI", 1, "Whether Brotli compression backend is available");
            ADD_FLAG("CFLAGS_TRUE_ASYNC_SERVER", "/D BROTLI_STATIC_DEFINE /D HAVE_HTTP_BROTLI=1");
            ADD_SOURCES(configure_module_dirname + "/src/compression",
                "http_compression_brotli.c", "true_async_server");
        } else {
            WARNING("Brotli backend disabled: libbrotli not found in '" + PHP_PHP_BUILD + "'.");
        }
    }

    // zstd — single library, drops in. static lib is named zstd_static.lib
    // by upstream's CMake; some distributions ship libzstd.lib instead.
    if (PHP_ZSTD == "yes" && PHP_HTTP_COMPRESSION == "yes") {
        if (CHECK_HEADER_ADD_INCLUDE("zstd.h", "CFLAGS_TRUE_ASYNC_SERVER", PHP_PHP_BUILD + "\\include")
            && CHECK_LIB("zstd_static.lib;zstd.lib;libzstd.lib", "true_async_server")) {
            AC_DEFINE("HAVE_HTTP_ZSTD", 1, "Whether zstd compression backend is available");
            ADD_FLAG("CFLAGS_TRUE_ASYNC_SERVER", "/D ZSTD_STATIC_LINKING_ONLY /D HAVE_HTTP_ZSTD=1");
            ADD_SOURCES(configure_module_dirname + "/src/compression",
                "http_compression_zstd.c", "true_async_server");
        } else {
            WARNING("zstd backend disabled: libzstd not found in '" + PHP_PHP_BUILD + "'.");
        }
    }

    // Windows socket libs — http_server does raw accept/socket work.
    ADD_FLAG("LIBS", "ws2_32.lib Mswsock.lib");

}
